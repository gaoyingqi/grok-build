[
  {
    "name": "initialize ok",
    "method": "initialize",
    "params": {
      "protocolVersion": 1,
      "capabilities": { "terminal": false, "fs": false },
      "client": { "mcpServers": [] },
      "_meta": { "modelId": "grok-code-fast" }
