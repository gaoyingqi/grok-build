    "params": { "client": { "mcpServers": [{ "name": "evil" }] } },
    "expect": "reject",
    "rejection": "ClientMcpServersNotAllowed"
  },
  {
    "name": "initialize unknown meta key",
    "method": "initialize",
    "params": { "_meta": { "sneaky": 1 } },
    "expect": "reject",
    "rejection": "UnknownMetaKey"
  },
  {
    "name": "initialize unknown top-level field",
