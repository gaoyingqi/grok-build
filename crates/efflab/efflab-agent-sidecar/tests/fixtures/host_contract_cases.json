    "expect": "allow"
  },
  {
    "name": "initialize terminal capability",
    "method": "initialize",
    "params": { "capabilities": { "terminal": true, "fs": false } },
    "expect": "reject",
    "rejection": "TerminalCapabilityEnabled"
  },
  {
    "name": "initialize fs capability",
    "method": "initialize",
    "params": { "capabilities": { "terminal": false, "fs": true } },
    "expect": "reject",
    "rejection": "FsCapabilityEnabled"
  },
  {
    "name": "initialize client mcpServers",
